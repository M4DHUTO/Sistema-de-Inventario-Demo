# Configuración del Servidor
PORT=5000
NODE_ENV=development

# Configuración de PostgreSQL
# Opción 1: Parámetros individuales (recomendado para desarrollo local)
PGHOST=localhost
PGPORT=5432
PGDATABASE=inventario_db
PGUSER=postgres
PGPASSWORD=postgres

# Opción 2: String de conexión (ej. para Supabase, Neon, Railway, Render)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventario_db

# Origen permitido para CORS (Frontend)
CORS_ORIGIN=http://localhost:5173
